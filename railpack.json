{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": { "python": "3.12" },
  "steps": {
    "cv": {
      "inputs": [{ "step": "packages:mise" }],
      "commands": [
        "python -m venv /opt/cv-venv",
        "/opt/cv-venv/bin/pip install --no-cache-dir numpy==1.26.4 opencv-python-headless==4.10.0.84"
      ],
      "deployOutputs": ["/opt/cv-venv"]
    }
  }
}
