# Lokaal: SQLite-bestand. Op Railway: pad naar het gekoppelde Volume, bv. file:/data/krachtbal.db
DATABASE_URL=file:./krachtbal.db

# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Productiedomein van het platform, bv. https://livescore.kvkbf.be
# Zodra dit gezet is, vergrendelt Payload credentialed admin/REST-calls tot dit domein
# (CORS + CSRF). Laat het LEEG lokaal — dan blijft de standaard same-origin-login werken.
# PUBLIC_SERVER_URL=https://livescore.kvkbf.be

# Opslagmap voor geüploade media (clublogo's).
# Op Railway: koppel een Volume aan de service — dan zet Railway automatisch
# RAILWAY_VOLUME_MOUNT_PATH en worden logo's daar bewaard, zodat ze deploys/
# herstarts overleven. MEDIA_DIR hoef je dan NIET in te stellen.
# Wil je toch een vast pad afdwingen, zet dan MEDIA_DIR (heeft voorrang).
# Lokaal weglaten → valt terug op ./media
# MEDIA_DIR=/data/media

# Chromecast: App ID van je "Custom Receiver" uit de Google Cast Developer
# Console (https://cast.google.com/publish). De receiver moet wijzen naar
# https://<jouw-domein>/cast-tv. Zonder deze waarde toont /cast een uitleg in
# plaats van casten. Zie docs/CHROMECAST.md.
# NEXT_PUBLIC_CAST_APP_ID=

# Push-meldingen (Web Push / VAPID). Genereer één keer een sleutelpaar met:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Zonder deze sleutels werkt de app gewoon, maar zijn push-meldingen uitgeschakeld
# (de opt-in-knop verschijnt niet). De PUBLIC-sleutel mag client-side (NEXT_PUBLIC),
# de PRIVATE-sleutel is server-only — nooit committen.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@krachtbal.be
