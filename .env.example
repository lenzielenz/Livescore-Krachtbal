# Lokaal: SQLite-bestand. Op Railway: pad naar het gekoppelde Volume, bv. file:/data/krachtbal.db
DATABASE_URL=file:./krachtbal.db

# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Opslagmap voor geüploade media (clublogo's). Op Railway: pad op het gekoppelde
# Volume zodat logo's deploys/herstarts overleven, bv. MEDIA_DIR=/data/media
# (Volume gemount op /data). Lokaal weglaten → valt terug op ./media
# MEDIA_DIR=/data/media
